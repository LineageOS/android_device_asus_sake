cc_binary {
    name: "vendor.lineage.livedisplay-service.sake",
    vintf_fragments: ["vendor.lineage.livedisplay-service.sake.xml"],
    init_rc: ["vendor.lineage.livedisplay-service.sake.rc"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "SunlightEnhancement.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "libutils",
        "vendor.lineage.livedisplay-V1-ndk",
    ],
}
