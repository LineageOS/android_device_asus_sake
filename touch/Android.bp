cc_binary {
    name: "vendor.lineage.touch-service.sake",
    init_rc: ["vendor.lineage.touch-service.sake.rc"],
    vintf_fragments: ["vendor.lineage.touch-service.sake.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "GloveMode.cpp",
        "HighTouchPollingRate.cpp",
        "TouchscreenGesture.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libutils",
        "vendor.lineage.touch-V1-ndk",
    ],
}
